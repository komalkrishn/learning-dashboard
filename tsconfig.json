{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/page.tsx",
    "components/**/*.tsx",
    "data/**/*.ts",
    "hooks/**/*.ts",
    "lib/utils.ts",
    "main.tsx",
    "sandbox/**/*.ts",
    "vite.local.config.ts"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}